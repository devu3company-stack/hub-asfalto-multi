# Banco PostgreSQL
DATABASE_URL="postgresql://hub:TROQUE_ESTA_SENHA@localhost:5432/hub?schema=public"
POSTGRES_PASSWORD="TROQUE_ESTA_SENHA"

# Endereço público do hub (usado para montar as URLs de webhook)
APP_URL="https://hub.asfaltomulti.com.br"

# Segredo da sessão de login (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Chave que criptografa as credenciais das integrações. Gere com: openssl rand -base64 32
# ATENÇÃO: se perder ou trocar esta chave, será preciso cadastrar as integrações de novo.
ENCRYPTION_KEY=""

# Primeiro administrador (usado só pelo comando de seed)
ADMIN_NAME="Jesimiel"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Token interno entre o hub e a conexão do WhatsApp. Gere com: openssl rand -hex 24
WA_GATEWAY_TOKEN=""
